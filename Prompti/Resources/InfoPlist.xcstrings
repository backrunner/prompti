    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompti uses the microphone only while you practise a spoken answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompti 仅在你录音作答时使用麦克风。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompti transcribes your answer to provide language feedback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompti 会把你的回答识别为文字，用于评估表达的意思是否准确。"
          }
        }
      }
    }
