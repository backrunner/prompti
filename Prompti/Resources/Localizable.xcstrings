    "Default practice" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "默认练习语言"}}}},
    "Choose the language used for translations and explanations" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "选择翻译和讲解使用的语言"}}}},
    "Question %lld of %lld" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "第 %1$lld 题，共 %2$lld 题"}}}},
