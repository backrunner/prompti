    "Works with any destination" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "适用于任何目的地"}}}},
    "City and country are all we need." : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "只需填写城市和国家或地区。"}}}},
