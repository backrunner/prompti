    "OpenAI Chat / Compatible" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "OpenAI Chat / 兼容服务"}}}},
    "Anthropic Messages" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "Anthropic Messages"}}}},
    "Recommended for new OpenAI setups" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "推荐用于新的 OpenAI 配置"}}}},
    "Chat Completions and compatible endpoints" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "Chat Completions 及兼容端点"}}}},
