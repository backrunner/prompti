    "API key" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "API 密钥"}}}},
    "Connection verified" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "连接已验证"}}}},
    "Exercises are generated on this device. Prompti still checks every question before showing it." : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "练习在此设备上生成。Prompti 仍会在展示前检查每道题。"}}}},
    "Your destination, language and selected scenes are sent directly to your provider. Prompti does not run a proxy server." : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "目的地、语言和所选场景会直接发送给服务商。Prompti 不会经由代理服务器转发。"}}}},
    "These defaults can be changed for every practice set." : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "每组练习都可以单独调整这些默认值。"}}}},
    "Short phrases and generous hints" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "短句表达，并提供充分提示"}}}},
    "Everyday sentences for simple conversations" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "适合简单对话的日常句子"}}}},
    "Natural phrasing and closer distractors" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "更自然的表达和更接近的干扰项"}}}},
    "Nuanced, region-aware conversation" : {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "细腻且符合当地语境的对话"}}}},
